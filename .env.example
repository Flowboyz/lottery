# Ditto Dinky - Environment Configuration
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development

# Database (SQLite default, switch to PostgreSQL for production)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ditto_dinky

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (for OTP / notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@dittodinky.com

# Default Admin Account (created by seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@dittodinky.com
